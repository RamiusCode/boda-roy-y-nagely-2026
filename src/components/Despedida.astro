---
// src/components/Despedida.astro
// Cierre de la invitación: "Confirmar Asistencia" arriba, el mismo sobre
// de la portada con la tarjeta bordó por delante ("¡Te
// esperamos!" y el botón que abre WhatsApp) y, al pie, los nombres.
//
// El sello de lacre es parte de la imagen del sobre; para que quede POR
// ENCIMA de la tarjeta se repite la misma imagen recortada al sello,
// igual que en Portada.astro.

/*
   Cuántos lugares reserva la invitación. Hoy Invitacion.astro no se lo
   pasa, así que queda en 0 y no se dibuja el renglón del pase. Para
   mostrarlo: <Despedida pases={pases} /> en Invitacion.astro.
*/
export interface Props {
    pases?: number;
    // Con un invitado, en vez de WhatsApp se confirma con un formulario
    invitado?: string;
    /*
       Conectada al panel de invitados (index.astro): se dibujan las dos
       formas de confirmar. Arranca con WhatsApp, como siempre, y si el link
       (?i=) trae un invitado que existe en la base, cambia al formulario y
       la respuesta se guarda en el sistema.
    */
    conectado?: boolean;
}
const { pases = 0, invitado = "", conectado = false } = Astro.props;
// Con formulario: un invitado fijo (muestra) o la versión conectada
const conFormulario = Boolean(invitado) || conectado;
// Mientras no llega el invitado de la base, la ventana lleva un número
// de molde: el script copia ese botón uno por pase
const pasesVentana = invitado ? pases : 1;

import { enlaceConfirmar } from "../scripts/mensajeConfirmar";
import { pasesReservados } from "../scripts/frasesPase";
import { tamanoNombres } from "../scripts/tamanoNombres";

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Confirmar Asistencia";
const frase = "Será un honor contar con tu presencia";
const esperamos = "¡Te esperamos!";
const novios = "Roy & Nagely";
// El cierre, como la firma de una carta: la despedida y la fecha corta
const despedidaFirma = "Con amor";
const fechaCorta = "29 · 11 · 2026";
// El sobre con flores y sello (el mismo de la portada). Viene sin letras:
// el monograma se escribe encima con las iniciales de `novios`.
const sobre = "/imagenes/sobre-portada.webp";
const nombresNovios = novios.split("&").map((nombre) => nombre.trim());
// Van en un renglón: con nombres largos la letra se achica para entrar
const tamanoCierre = tamanoNombres(novios, 12.5, 166);
const iniciales = nombresNovios.map((nombre) => nombre.charAt(0));

/*
   El botón abre WhatsApp con el mensaje ya escrito, y el nombre que el
   invitado ponga en la casilla va adentro. El texto se arma en
   src/scripts/mensajeConfirmar.ts. El número va con el código de país y
   sin el + ni espacios, que es como lo pide wa.me.
*/
const noviosMensaje = "Roy y Nagely";
const fecha = "29 de noviembre de 2026";
// Un botón por número: el invitado elige a quién le confirma
const contactos = [
    { texto: "Confirmar con el novio", telefono: "59178447718" },
    { texto: "Confirmar con la novia", telefono: "59172684699" },
];
const placeholderNombre = "Escribe tu nombre";
/*
   Un enlace fijo para todos los botones. En el modelo de muestra va "#":
   los botones no llevan a ningún lado. También puede ir un link (por
   ejemplo un wa.link), pero entonces el mensaje no lleva el nombre del
   invitado. Vacío (""), cada botón vuelve a armar su mensaje con el
   nombre y su número.
*/
const enlaceFijo = "";

/*
   El pase se arma solo con el número que llega por props: 1 da "Pase para
   una persona" y 2 "Pase para dos personas". Si el número pasa la lista,
   cae al dígito ("Pase para 12 personas"). En 0 queda en null.
*/
const enLetras = [
    "", // el 0 no se usa: está para que el 1 caiga en "una"
    "una",
    "dos",
    "tres",
    "cuatro",
    "cinco",
    "seis",
    "siete",
    "ocho",
    "nueve",
    "diez",
];
const cantidad = enLetras[pases] ?? String(pases);
const pase =
    pases > 0
        ? `Pase para ${cantidad} ${pases === 1 ? "persona" : "personas"}`
        : null;
// ──────────────────────────────────────────────────────────────
---

<section id="despedida" class="seccion">
    <p class="titulo font-great-vibes">{titulo}</p>

    <div id="grupo-despedida" class="grupo">
        <!-- El sobre, con sus flores, monograma y sello -->
        <img
            src={sobre}
            alt=""
            width="1400"
            height="971"
            aria-hidden="true"
            class="sobre"
        />
        <p class="monograma" aria-hidden="true">
            {iniciales[0]}<em>&</em>{iniciales[1]}
        </p>

        <!-- Tarjeta bordó por delante del sobre -->
        <div class="tarjeta">
            <p class="t-frase">{frase}</p>
            <p class="t-esperamos font-great-vibes">{esperamos}</p>
            {!invitado && pase && <p class="t-pase">{pase}</p>}
            {conFormulario && (
            <div
                class="botones"
                id="botones-formulario"
                style={invitado ? undefined : "display: none"}
            >
                <button type="button" class="boton" id="abrir-confirmacion">
                    <span class="boton-texto">Confirmar asistencia</span>
                    <span class="boton-brillo" aria-hidden="true" />
                </button>
            </div>
            )}
            {!invitado && (<>
            <label class="t-nombre" data-whatsapp>
                <span class="t-nombre-check" aria-hidden="true">✓</span>
                <input
                    id="confirmar-nombre"
                    type="text"
                    name="nombre"
                    autocomplete="name"
                    placeholder={placeholderNombre}
                    aria-label="Tu nombre"
                />
            </label>
            <div class="botones" data-whatsapp>
                {
                    contactos.map((c) => {
                        const datos = {
                            telefono: c.telefono,
                            novios: noviosMensaje,
                            fecha,
                        };
                        return (
                            <a
                                class="boton"
                                href={enlaceFijo || enlaceConfirmar(datos)}
                                data-confirmar={
                                    enlaceFijo ? undefined : JSON.stringify(datos)
                                }
                                target={enlaceFijo === "#" ? undefined : "_blank"}
                                rel="noopener noreferrer"
                            >
                                <span class="boton-texto">{c.texto}</span>
                                <span class="boton-brillo" aria-hidden="true" />
                            </a>
                        );
                    })
                }
            </div>
            </>)}

            <!-- Flor colgando en la esquina de abajo a la derecha -->
            <img
                src="/imagenes/florabajonuevo.png"
                alt=""
                width="538"
                height="1204"
                aria-hidden="true"
                class="flor-abajo"
            />
        </div>

        <!-- El sello otra vez, recortado, para que pise la tarjeta -->
        <img
            src={sobre}
            alt=""
            width="1400"
            height="971"
            aria-hidden="true"
            class="sobre sello"
        />
    </div>

    {
        conFormulario && (
            <dialog
                class="confirmacion"
                id="ventana-confirmacion"
                data-pases={pasesVentana}
                data-conectado={conectado ? "" : undefined}
            >
                <button type="button" class="c-cerrar" aria-label="Cerrar">×</button>

                <!-- Paso 1: el formulario -->
                <form class="c-paso c-formulario" method="dialog">
                    <p class="c-titulo">Confirmación de asistencia</p>
                    <p class="c-nombre font-great-vibes">{invitado}</p>
                    <div class="c-adorno" aria-hidden="true">
                        <i class="adorno-linea adorno-izq"></i>
                        <i class="adorno-rombo"></i>
                        <i class="adorno-linea adorno-der"></i>
                    </div>
                    <p class="c-reservado">
                        Tienes <strong>{pasesVentana}</strong> <span class="c-palabra">{pasesReservados(pasesVentana)}</span>.
                    </p>

                    <p class="c-pregunta">¿Cuántos asistirán?</p>
                    <div class="c-cantidades" role="radiogroup" aria-label="Cuántos asistirán">
                        {
                            Array.from({ length: pasesVentana }).map((_, i) => (
                                <label class="c-cantidad">
                                    <input
                                        type="radio"
                                        name="asistentes"
                                        value={i + 1}
                                        checked={i + 1 === pasesVentana}
                                    />
                                    <span>{i + 1}</span>
                                </label>
                            ))
                        }
                    </div>

                    <button type="submit" class="boton c-confirmar" value="si">
                        <span class="boton-texto">Confirmar asistencia</span>
                    </button>
                    <button type="submit" class="c-no" value="no">No podré asistir</button>
                </form>

                <!-- Paso 2: la respuesta -->
                <div class="c-paso c-gracias" hidden>
                    <div class="c-icono" aria-hidden="true">✓</div>
                    <p class="c-titulo">¡Muchas gracias!</p>
                    <p class="c-nombre font-great-vibes">{invitado}</p>
                    <div class="c-adorno" aria-hidden="true">
                        <i class="adorno-linea adorno-izq"></i>
                        <i class="adorno-rombo"></i>
                        <i class="adorno-linea adorno-der"></i>
                    </div>
                    <p class="c-reservado c-respuesta"></p>
                    <p class="c-detalle"></p>
                    <button type="button" class="c-no c-cambiar">Cambiar mi respuesta</button>
                </div>
            </dialog>
        )
    }

    <!-- El cierre, como la firma de una carta -->
    <div class="cierre" id="cierre-despedida">
        <div class="adorno" aria-hidden="true">
            <i class="adorno-linea adorno-izq"></i>
            <i class="adorno-rombo"></i>
            <i class="adorno-linea adorno-der"></i>
        </div>
        <p class="firma">{despedidaFirma}</p>
        <p
            class="novios font-great-vibes"
            aria-label={novios}
            style={`font-size: ${tamanoCierre}cqw;`}
        >
            <span class="novio" aria-hidden="true">{nombresNovios[0]}</span>
            <em class="amp" aria-hidden="true">&</em>
            <span class="novia" aria-hidden="true">{nombresNovios[1]}</span>
        </p>
        <p class="fecha-corta">{fechaCorta}</p>
    </div>
</section>

<style>
    .seccion {
        /* Las letras se miden contra el ancho de la sección */
        container-type: inline-size;
        position: relative;
        width: 100%;
        /* Aire abajo: es el final de la página y el botón de la música
           no tiene que tapar los nombres */
        padding: 8cqw 0 22cqw;
        text-align: center;
    }

    .titulo {
        margin: 0;
        /* Aire para los rulos: la entrada lo recorta de izquierda a derecha */
        padding: 0 4cqw;
        display: inline-block;
        color: #9a7433;
        font-size: 12cqw;
        line-height: 1.15;
    }

    /* ── Sobre + tarjeta ────────────────────────────────────── */
    .grupo {
        position: relative;
        width: 80cqw;
        margin: 6cqw auto 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .sobre {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
        filter: drop-shadow(0 8px 14px rgba(60, 45, 25, 0.18));
    }

    /*
       El monograma, dentro del marco del sobre (41,3% a 62,7% de ancho,
       29,6% de alto). El alto se mide contra el grupo, que es más alto
       que el sobre, así que la posición va con margen: en % del ancho.
    */
    .monograma {
        position: absolute;
        top: 0;
        left: 41.3%;
        z-index: 1;
        width: 21.4%;
        aspect-ratio: 21.4 / 11.1;
        margin: 20.5% 0 0;
        display: flex;
        align-items: center;
        justify-content: center;
        /* Letra recta y en negrita: se lee mejor que la cursiva y no se
           sale del marco */
        font-family: "Cinzel", serif;
        font-weight: 700;
        font-size: 4.8cqw;
        line-height: 1;
        color: #7c8754;
        pointer-events: none;
    }

    .monograma em {
        font-style: normal;
        font-size: 0.62em;
    }

    /*
       El sello de lacre (centro en 51,2% / 64,8% de la imagen del sobre)
       recortado de una segunda copia, para que quede encima de la tarjeta.
    */
    .sello {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 3;
        pointer-events: none;
        clip-path: ellipse(10.6% 14.5% at 51.7% 64.4%);
        filter: drop-shadow(0 3px 4px rgba(60, 40, 10, 0.35));
    }

    /*
       La tarjeta arranca a la altura del sello: el margen negativo (en %
       del ancho del grupo) la sube sobre la parte de abajo del sobre.
       Es más ancha que la de la portada: casi todo el sobre.
    */
    .tarjeta {
        position: relative;
        z-index: 2;
        width: 98%;
        margin-top: -25%;
        padding: 14cqw 6cqw 7cqw;
        display: flex;
        flex-direction: column;
        align-items: center;
        color: #f4efe3;
        /* Como imagen y no como color: el modo oscuro forzado la respeta */
        background-image:
            radial-gradient(
                ellipse at 50% 20%,
                rgba(255, 255, 255, 0.06) 0%,
                rgba(255, 255, 255, 0) 60%
            ),
            linear-gradient(180deg, #6f7a4a 0%, #667043 100%);
        box-shadow: 0 12px 26px rgba(70, 78, 46, 0.3);
    }

    .t-frase {
        margin: 0;
        font-family: "Cinzel", serif;
        font-size: 4.4cqw;
        line-height: 1.3;
        letter-spacing: 0.03em;
    }

    .t-esperamos {
        margin: 3cqw 0 0;
        font-size: 7.6cqw;
        line-height: 1.15;
        color: #f7f2e6;
    }

    .t-pase {
        margin: 2cqw 0 0;
        font-family: "Cinzel", serif;
        font-size: 3.8cqw;
        letter-spacing: 0.03em;
        color: #efe8d6;
    }

    /* Casilla del nombre: una línea crema sobre el bordó, con el ✓ */
    .t-nombre {
        display: flex;
        align-items: center;
        gap: 2cqw;
        width: 78%;
        margin-top: 5cqw;
        padding: 0 1cqw 1.4cqw;
        border-bottom: 1px solid rgba(239, 232, 214, 0.6);
    }

    .t-nombre-check {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 5.4cqw;
        height: 5.4cqw;
        border-radius: 50%;
        font-size: 3.4cqw;
        line-height: 1;
        color: #6f7a4a;
        background-image: linear-gradient(#efe8d6, #efe8d6);
    }

    .t-nombre input {
        flex: 1;
        min-width: 0;
        padding: 0;
        border: 0;
        outline: none;
        background: transparent;
        font-family: "Cormorant Garamond", serif;
        font-style: italic;
        /* 16px como mínimo: con menos, el iPhone hace zoom al escribir */
        font-size: max(16px, 4.8cqw);
        color: #f4efe3;
        text-align: center;
    }

    .t-nombre input::placeholder {
        color: rgba(244, 239, 227, 0.6);
    }

    /* Aviso suave si tocan Confirmar sin nombre */
    .t-nombre.falta {
        border-bottom-color: #f2d58a;
    }

    .botones {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3cqw;
        margin-top: 5cqw;
    }

    /* Dorado champán sobre el bordó, con un hilo claro adentro. Todos
       del mismo ancho y siempre en un solo renglón */
    .boton {
        display: block;
        width: 72cqw;
        box-sizing: border-box;
        padding: 2.4cqw 4cqw;
        border-radius: 999px;
        font-family: "Cinzel", serif;
        font-weight: 600;
        font-size: 3.8cqw;
        line-height: 1;
        letter-spacing: 0.06em;
        white-space: nowrap;
        text-align: center;
        text-decoration: none;
        color: #667043;
        background-image: linear-gradient(
            180deg,
            #f3e3bd 0%,
            #e3c88c 55%,
            #d2b06a 100%
        );
        box-shadow:
            inset 0 0 0 1px rgba(255, 250, 235, 0.7),
            0 4px 12px rgba(36, 40, 22, 0.35);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    /* El brillo que cruza los botones cada tanto, recortado a su forma */
    .boton {
        position: relative;
        overflow: hidden;
    }

    .boton-texto {
        position: relative;
        z-index: 1;
    }

    .boton-brillo {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 35%;
        background-image: linear-gradient(
            105deg,
            rgba(255, 250, 235, 0) 0%,
            rgba(255, 250, 235, 0.7) 50%,
            rgba(255, 250, 235, 0) 100%
        );
        transform: translateX(-130%);
    }

    .boton:active {
        transform: scale(0.97);
        box-shadow:
            inset 0 0 0 1px rgba(255, 250, 235, 0.7),
            0 2px 6px rgba(36, 40, 22, 0.3);
    }

    button.boton {
        border: 0;
        cursor: pointer;
    }

    /* ── Ventana de confirmación ──────────────────────────────── */
    .confirmacion {
        container-type: inline-size;
        width: min(88vw, 400px);
        max-height: 92vh;
        /* Centrada en la pantalla: el reset de Tailwind le saca el margen */
        margin: auto;
        padding: 0;
        border: 0;
        border-radius: 22px;
        overflow: auto;
        text-align: center;
        color: #56603a;
        /* Papel crema, como imagen para el modo oscuro forzado */
        background-image: linear-gradient(#fdfaf3, #fdfaf3);
        box-shadow:
            inset 0 0 0 6px #fdfaf3,
            inset 0 0 0 7px rgba(192, 154, 82, 0.55),
            0 20px 50px rgba(36, 40, 22, 0.4);
    }

    .confirmacion::backdrop {
        background: rgba(36, 40, 22, 0.55);
        backdrop-filter: blur(3px);
    }

    .confirmacion[open] {
        animation: aparecer 0.45s cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    @keyframes aparecer {
        from {
            opacity: 0;
            transform: translateY(24px) scale(0.96);
        }
    }

    .c-cerrar {
        position: absolute;
        top: 10px;
        right: 14px;
        z-index: 1;
        padding: 4px 8px;
        border: 0;
        background: none;
        font-size: 26px;
        line-height: 1;
        color: #9a8f78;
        cursor: pointer;
    }

    .c-paso {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 10cqw 7cqw 8cqw;
    }

    .c-paso[hidden] {
        display: none;
    }

    .c-titulo {
        margin: 0;
        font-family: "Cinzel", serif;
        font-size: 4.2cqw;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #6f7a4a;
    }

    .c-nombre {
        margin: 2cqw 0 0;
        font-size: 10cqw;
        line-height: 1.2;
        color: #56603a;
    }

    .c-adorno {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.4cqw;
        margin-top: 3cqw;
    }

    .c-adorno .adorno-linea {
        width: 30cqw;
    }

    .c-reservado {
        margin: 4cqw 0 0;
        font-family: "Cormorant Garamond", serif;
        font-size: 5.6cqw;
        line-height: 1.3;
    }

    .c-reservado strong {
        font-family: "Cinzel", serif;
        font-weight: 700;
        color: #9a7433;
    }

    .c-pregunta {
        margin: 6cqw 0 0;
        font-family: "Cinzel", serif;
        font-size: 3.6cqw;
        letter-spacing: 0.05em;
        color: #8a6a36;
    }

    .c-cantidades {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 3cqw;
        margin-top: 3cqw;
    }

    .c-cantidad input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .c-cantidad span {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 12cqw;
        height: 12cqw;
        border-radius: 50%;
        font-family: "Cinzel", serif;
        font-weight: 700;
        font-size: 5cqw;
        color: #6f7a4a;
        cursor: pointer;
        background-image: linear-gradient(#fbf8f2, #fbf8f2);
        box-shadow: inset 0 0 0 1.5px rgba(111, 122, 74, 0.45);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            color 0.2s ease;
    }

    /* La elegida, en verde con borde dorado */
    .c-cantidad input:checked + span {
        color: #f8f3ea;
        background-image: linear-gradient(#6f7a4a, #6f7a4a);
        box-shadow:
            inset 0 0 0 2px #d2b06a,
            0 4px 10px rgba(70, 78, 46, 0.3);
        transform: scale(1.08);
    }

    .c-cantidad input:focus-visible + span {
        outline: 2px solid #c09a52;
        outline-offset: 3px;
    }

    /* Verde con letras crema y borde dorado */
    .c-confirmar {
        width: 100%;
        margin-top: 7cqw;
        padding: 4.2cqw 4cqw;
        font-size: 4cqw;
        color: #f8f3ea;
        background-image: linear-gradient(#6f7a4a, #6f7a4a);
        box-shadow:
            inset 0 0 0 2px #d2b06a,
            0 6px 16px rgba(70, 78, 46, 0.35);
    }

    .c-no {
        margin-top: 5cqw;
        padding: 0 0 2px;
        border: 0;
        border-bottom: 1px solid currentColor;
        background: none;
        font-family: "Cormorant Garamond", serif;
        font-size: 4.4cqw;
        color: #6f7a4a;
        cursor: pointer;
    }

    .c-icono {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 15cqw;
        height: 15cqw;
        margin-bottom: 4cqw;
        border-radius: 50%;
        font-size: 7cqw;
        color: #fdfaf3;
        background-image: linear-gradient(#6f7a4a, #6f7a4a);
        box-shadow:
            0 0 0 4px #fdfaf3,
            0 0 0 5px #c09a52;
    }

    .c-detalle {
        margin: 3cqw 0 0;
        font-family: "Cormorant Garamond", serif;
        font-style: italic;
        font-size: 4.6cqw;
        line-height: 1.35;
        color: #6e5a52;
    }

    /* Cuelga desde la esquina de abajo a la derecha, pisando el borde */
    .flor-abajo {
        position: absolute;
        right: -4%;
        bottom: -14%;
        width: 13%;
        height: auto;
        pointer-events: none;
        user-select: none;
        filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.2));
    }

    /* ── El cierre ─────────────────────────────────────────────── */
    .cierre {
        margin-top: 14cqw;
    }

    .adorno {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.4cqw;
    }

    .adorno-linea {
        display: block;
        width: 18cqw;
        height: 1px;
    }

    .adorno-izq {
        background-image: linear-gradient(
            90deg,
            rgba(176, 141, 87, 0) 0%,
            #b08d57 100%
        );
        transform-origin: 100% 50%;
    }

    .adorno-der {
        background-image: linear-gradient(
            90deg,
            #b08d57 0%,
            rgba(176, 141, 87, 0) 100%
        );
        transform-origin: 0% 50%;
    }

    .adorno-rombo {
        display: block;
        width: 1.9cqw;
        height: 1.9cqw;
        border: 1px solid #b08d57;
        transform: rotate(45deg);
    }

    /* "Con amor": Cinzel espaciada y dorada, como el "Nos casamos" */
    .firma {
        margin: 5cqw 0 0;
        font-family: "Cinzel", serif;
        font-size: 4.2cqw;
        line-height: 1;
        letter-spacing: 0.36em;
        /* el espaciado deja aire a la derecha: esto lo compensa */
        text-indent: 0.36em;
        text-transform: uppercase;
        color: #8a6a36;
    }

    .novios {
        margin: 2cqw 0 0;
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 2.6cqw;
        color: #6f7a4a;
        font-size: 12.5cqw;
        line-height: 1.15;
        white-space: nowrap;
    }

    /* Cada nombre con aire para los rulos: la entrada lo recorta */
    .novio,
    .novia {
        display: inline-block;
        padding: 0 2cqw;
    }

    /* El "&" más chico y dorado, como en NombresFlores */
    .amp {
        display: inline-block;
        font-style: normal;
        font-size: 0.62em;
        padding: 0 1cqw;
        background-image: linear-gradient(
            135deg,
            #e6cd8c 0%,
            #b8913f 45%,
            #8f6a26 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .fecha-corta {
        margin: 3cqw 0 0;
        font-family: "Cinzel", serif;
        font-size: 4cqw;
        line-height: 1;
        letter-spacing: 0.22em;
        text-indent: 0.22em;
        color: #6e5a52;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import {
        enlaceConfirmar,
        type DatosConfirmar,
    } from "../scripts/mensajeConfirmar";

    import { asistiran, pasesReservados } from "../scripts/frasesPase";
    import {
        datosInvitado,
        confirmarAsistencia,
        alCambiarInvitado,
        type Invitado,
    } from "../lib/invitado";

    gsap.registerPlugin(ScrollTrigger);

    /*
       La ventana de confirmación.
       - En /muestra (invitado fijo) es solo el diseño: la respuesta no se
         manda a ningún lado, solo se muestra el agradecimiento.
       - Conectada (index.astro con ?i=): se llena con el invitado que manda
         la base y la respuesta se guarda en el sistema. Si el link no trae
         un invitado válido, queda la confirmación por WhatsApp de siempre.
    */
    document.addEventListener("DOMContentLoaded", () => {
        const ventana = document.getElementById(
            "ventana-confirmacion",
        ) as HTMLDialogElement | null;
        const abrir = document.getElementById("abrir-confirmacion");
        if (!ventana || !abrir) return;

        const conectada = ventana.hasAttribute("data-conectado");
        const formulario = ventana.querySelector<HTMLFormElement>(".c-formulario")!;
        const gracias = ventana.querySelector<HTMLElement>(".c-gracias")!;
        const respuesta = ventana.querySelector<HTMLElement>(".c-respuesta")!;
        const detalle = ventana.querySelector<HTMLElement>(".c-detalle")!;
        const tituloGracias = gracias.querySelector<HTMLElement>(".c-titulo");
        const iconoGracias = gracias.querySelector<HTMLElement>(".c-icono");
        const textoTituloGracias = tituloGracias?.textContent ?? "";
        const pregunta = ventana.querySelector<HTMLElement>(".c-pregunta");
        const cantidades = ventana.querySelector<HTMLElement>(".c-cantidades");
        const confirmar = formulario.querySelector<HTMLButtonElement>(".c-confirmar");
        const textoConfirmar = confirmar?.querySelector<HTMLElement>(".boton-texto");
        const textoBotonConfirmar = textoConfirmar?.textContent ?? "";
        const envios = formulario.querySelectorAll<HTMLButtonElement>(
            'button[type="submit"]',
        );

        let pases = Number(ventana.dataset.pases) || 1;
        // En la muestra se elige como en el diseño. Conectada, lo decide el
        // panel: solo con la función `cantidad` prendida.
        let eligeCantidad = true;
        // Mientras el invitado no toque los números, la cantidad sigue a los
        // pases: si los novios corrigen de 4 a 5, confirma 5.
        let eligioAMano = false;

        const mostrar = (paso: "formulario" | "gracias") => {
            formulario.hidden = paso !== "formulario";
            gracias.hidden = paso !== "gracias";
        };

        function agradecer(viene: boolean, cantidad: number) {
            if (tituloGracias) tituloGracias.textContent = textoTituloGracias;
            if (iconoGracias) iconoGracias.style.display = "";
            if (viene) {
                respuesta.textContent = `${asistiran(cantidad)}.`;
                detalle.textContent =
                    "Te esperamos el 29 de noviembre para celebrar juntos.";
            } else {
                respuesta.textContent = "Lamentamos que no puedas acompañarnos.";
                detalle.textContent =
                    "Gracias por avisarnos. Te llevamos en el corazón ese día.";
            }
            mostrar("gracias");
        }

        // La base no contestó: se avisa en vez de agradecer, para que el
        // invitado no crea que quedó confirmado
        function avisarFallo() {
            if (tituloGracias) tituloGracias.textContent = "No se pudo enviar";
            if (iconoGracias) iconoGracias.style.display = "none";
            respuesta.textContent = "No pudimos guardar tu respuesta.";
            detalle.textContent =
                "Revisa tu conexión e inténtalo de nuevo en un momento.";
            mostrar("gracias");
        }

        // Cuántos van a ir según lo marcado, dentro de los pases
        function elegida(): number {
            if (!eligeCantidad) return pases;
            const marcada = Number(new FormData(formulario).get("asistentes"));
            if (!Number.isInteger(marcada) || marcada < 1) return pases;
            return Math.min(marcada, pases);
        }

        // Un botón por pase. Se copia el que ya está dibujado para que
        // conserve los estilos del componente.
        function pintarCantidades(marcada: number) {
            if (!cantidades) return;
            const molde = cantidades.querySelector(".c-cantidad");
            if (!molde) return;

            if (cantidades.querySelectorAll(".c-cantidad").length !== pases) {
                const nuevos = Array.from({ length: pases }, (_, i) => {
                    const copia = molde.cloneNode(true) as HTMLElement;
                    const radio = copia.querySelector("input")!;
                    radio.value = String(i + 1);
                    radio.removeAttribute("checked");
                    const numero = copia.querySelector("span");
                    if (numero) numero.textContent = String(i + 1);
                    return copia;
                });
                cantidades.replaceChildren(...nuevos);
            }

            cantidades
                .querySelectorAll<HTMLInputElement>('input[name="asistentes"]')
                .forEach((r) => (r.checked = Number(r.value) === marcada));
        }

        cantidades?.addEventListener("change", () => (eligioAMano = true));

        function llenar(inv: Invitado, primeraVez: boolean) {
            const anterior = elegida();
            if (Number.isInteger(inv.pases) && inv.pases > 0) pases = inv.pases;
            ventana!.dataset.pases = String(pases);

            ventana!
                .querySelectorAll(".c-nombre")
                .forEach((el) => (el.textContent = inv.nombre));
            const numero = ventana!.querySelector(".c-reservado:not(.c-respuesta) strong");
            const palabra = ventana!.querySelector(".c-palabra");
            if (numero) numero.textContent = String(pases);
            if (palabra) palabra.textContent = pasesReservados(pases);

            // Se compara con === true: las bodas que no tienen la clave
            // confirman con todos sus pases, como antes
            eligeCantidad =
                (inv.funciones as { cantidad?: boolean } | undefined)?.cantidad ===
                true;
            for (const el of [pregunta, cantidades]) {
                if (el) el.style.display = eligeCantidad ? "" : "none";
            }

            let marcada: number;
            if (primeraVez && inv.asisten && inv.asisten > 0) {
                // Lo que ya había respondido
                marcada = Math.min(inv.asisten, pases);
                eligioAMano = true;
            } else {
                marcada = eligioAMano ? Math.min(anterior, pases) : pases;
            }
            pintarCantidades(marcada);

            // Si ya respondió, se le muestra su respuesta en vez del
            // formulario. Con la ventana abierta no se le cambia el paso
            // en la cara.
            if (ventana!.open) return;
            if (inv.confirmado === true) {
                agradecer(true, inv.asisten && inv.asisten > 0 ? inv.asisten : pases);
            } else if (inv.confirmado === false) {
                agradecer(false, 0);
            } else {
                mostrar("formulario");
            }
        }

        // Cuál de las dos formas de confirmar se ve en la tarjeta
        let conFormulario = !conectada;
        function usarFormulario(si: boolean) {
            if (si === conFormulario) return;
            conFormulario = si;
            document
                .querySelectorAll<HTMLElement>("#despedida [data-whatsapp]")
                .forEach((el) => (el.style.display = si ? "none" : ""));
            const botones = document.getElementById("botones-formulario");
            if (botones) botones.style.display = si ? "" : "none";
            if (!si && ventana!.open) ventana!.close();
            ScrollTrigger.refresh();
        }

        function alLlegar(inv: Invitado | null, primeraVez: boolean) {
            // Sin invitado (sin ?i=, borrado o sin conexión) queda como está
            if (!inv) return;

            // Boda sin la confirmación contratada: se queda con WhatsApp, con
            // el nombre del invitado ya escrito
            if (inv.funciones && inv.funciones.confirmacion === false) {
                usarFormulario(false);
                const casilla = document.getElementById(
                    "confirmar-nombre",
                ) as HTMLInputElement | null;
                if (casilla && !casilla.value.trim() && inv.nombre) {
                    casilla.value = inv.nombre;
                    casilla.dispatchEvent(new Event("input"));
                }
                return;
            }

            llenar(inv, primeraVez);
            usarFormulario(true);
        }

        if (conectada) {
            datosInvitado().then((inv) => alLlegar(inv, true));
            alCambiarInvitado((inv) => alLlegar(inv, false));
        }

        abrir.addEventListener("click", () => {
            if (!ventana.open) ventana.showModal();
        });
        ventana
            .querySelector(".c-cerrar")!
            .addEventListener("click", () => ventana.close());
        // Tocar afuera de la ventana la cierra
        ventana.addEventListener("click", (e) => {
            if (e.target === ventana) ventana.close();
        });

        let enviando = false;
        formulario.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (enviando) return;
            const viene =
                (e.submitter as HTMLButtonElement | null)?.value !== "no";
            const cantidad = elegida();

            // La muestra no guarda nada
            if (!conectada) {
                agradecer(viene, cantidad);
                return;
            }

            enviando = true;
            envios.forEach((b) => (b.disabled = true));
            if (viene && textoConfirmar) textoConfirmar.textContent = "Enviando...";

            // Nunca lanza: si falla devuelve null
            const fila = viene
                ? await confirmarAsistencia(true, cantidad)
                : await confirmarAsistencia(false);

            enviando = false;
            envios.forEach((b) => (b.disabled = false));
            if (textoConfirmar) textoConfirmar.textContent = textoBotonConfirmar;

            if (!fila) {
                avisarFallo();
                return;
            }
            agradecer(
                viene,
                viene && fila.asisten && fila.asisten > 0 ? fila.asisten : cantidad,
            );
        });

        ventana
            .querySelector(".c-cambiar")!
            .addEventListener("click", () => mostrar("formulario"));
    });

    // Los botones con "#" (modelo de muestra) no hacen nada: sin esto, el
    // "#" sube la página hasta arriba
    document.addEventListener("DOMContentLoaded", () => {
        document
            .querySelectorAll<HTMLAnchorElement>('#despedida a[href="#"]')
            .forEach((a) => a.addEventListener("click", (e) => e.preventDefault()));
    });

    // El nombre del invitado entra en el mensaje. Va aparte de las
    // animaciones: tiene que andar aunque el visitante pida menos movimiento.
    document.addEventListener("DOMContentLoaded", () => {
        const input = document.getElementById(
            "confirmar-nombre",
        ) as HTMLInputElement | null;
        const botones = Array.from(
            document.querySelectorAll<HTMLAnchorElement>(
                "#despedida .boton[data-confirmar]",
            ),
        );
        if (!input || botones.length === 0) return;

        const casilla = input.closest(".t-nombre");

        input.addEventListener("input", () => {
            botones.forEach((boton) => {
                const datos: DatosConfirmar = JSON.parse(
                    boton.dataset.confirmar!,
                );
                boton.href = enlaceConfirmar(datos, input.value);
            });
            if (input.value.trim()) casilla?.classList.remove("falta");
        });

        // Sin nombre no sale: se marca la casilla y se lo pide
        botones.forEach((boton) => {
            boton.addEventListener("click", (e) => {
                if (input.value.trim()) return;
                e.preventDefault();
                casilla?.classList.add("falta");
                input.focus();
                gsap.fromTo(
                    casilla,
                    { x: -6 },
                    { x: 0, duration: 0.5, ease: "elastic.out(1, 0.3)" },
                );
            });
        });
    });

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("despedida");
        const grupo = document.getElementById("grupo-despedida");
        if (!seccion || !grupo) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const tarjeta = grupo.querySelector(".tarjeta");
        const flor = grupo.querySelector(".flor-abajo");
        const botones = grupo.querySelectorAll(".boton");
        const brillos = grupo.querySelectorAll(".boton-brillo");

        // Los títulos en cursiva se escriben; los márgenes negativos dejan
        // pasar los rulos
        const tapado = "inset(-40% 100% -40% 0%)";
        const escrito = "inset(-40% 0% -40% 0%)";

        let vaiven: ReturnType<typeof gsap.to> | null = null;
        let destello: ReturnType<typeof gsap.to> | null = null;

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: seccion,
                start: "top 78%",
                toggleActions: "play none none reset",
            },
            // Si la entrada se repite, lo que sigue andando espera su turno
            onStart: () => {
                vaiven?.pause();
                destello?.pause(0);
            },
        });

        tl.fromTo(
            seccion.querySelector(".titulo"),
            { clipPath: tapado },
            { clipPath: escrito, duration: 1.4, ease: "power1.inOut" },
        )
            .fromTo(
                grupo,
                { opacity: 0, y: 30 },
                { opacity: 1, y: 0, duration: 1.1, ease: "power3.out" },
                0.6,
            )
            // La tarjeta sale del sobre, subiendo
            .fromTo(
                tarjeta,
                { y: 40 },
                { y: 0, duration: 1.2, ease: "power3.out" },
                0.8,
            )
            .fromTo(
                tarjeta?.querySelectorAll(".t-frase, .t-esperamos, .t-pase, .t-nombre") ??
                    [],
                { opacity: 0, y: 10 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.7,
                    stagger: 0.15,
                    ease: "power2.out",
                },
                1.2,
            )
            // Solo opacidad: los botones tienen una transición de transform
            // para el toque, y moverlos desde acá la traba
            .fromTo(
                botones,
                { opacity: 0 },
                {
                    opacity: 1,
                    duration: 0.8,
                    stagger: 0.15,
                    ease: "power2.out",
                },
                1.7,
            )
            .fromTo(
                flor,
                { opacity: 0, rotate: -8, transformOrigin: "50% 0%" },
                { opacity: 1, rotate: 0, duration: 1.1, ease: "power2.out" },
                1.1,
            )
            // Después: la flor se mece y un brillo cruza los botones cada
            // tanto. Se crean una sola vez: la entrada se repite al volver.
            .add(() => {
                if (vaiven && destello) {
                    vaiven.restart();
                    destello.restart();
                    return;
                }
                vaiven = gsap.to(flor, {
                    rotate: 3,
                    duration: 3.2,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
                destello = gsap.fromTo(
                    brillos,
                    { xPercent: -130 },
                    {
                        xPercent: 330,
                        duration: 1.2,
                        stagger: 0.25,
                        ease: "power2.inOut",
                        repeat: -1,
                        repeatDelay: 3.5,
                    },
                );
            });

        /*
           El cierre tiene su propio disparador: queda lejos. Arranca
           apenas asoma ("top bottom"): esta es la última sección y con un
           punto más exigente la página se termina antes de llegar, y los
           nombres se quedan invisibles.
        */
        const cierre = document.getElementById("cierre-despedida");
        if (cierre) {
            gsap.timeline({
                scrollTrigger: {
                    trigger: cierre,
                    start: "top bottom",
                    toggleActions: "play none none reset",
                },
            })
                // El adorno se dibuja desde el rombo
                .fromTo(
                    cierre.querySelector(".adorno-rombo"),
                    { opacity: 0, scale: 0, rotate: -45 },
                    {
                        opacity: 1,
                        scale: 1,
                        rotate: 45,
                        duration: 0.6,
                        ease: "back.out(2)",
                    },
                )
                .fromTo(
                    cierre.querySelectorAll(".adorno-linea"),
                    { scaleX: 0 },
                    { scaleX: 1, duration: 0.9, ease: "power2.out" },
                    0.15,
                )
                // "Con amor" se asienta, cerrando el espaciado
                .fromTo(
                    cierre.querySelector(".firma"),
                    { opacity: 0, letterSpacing: "0.7em" },
                    {
                        opacity: 1,
                        letterSpacing: "0.36em",
                        duration: 1.2,
                        ease: "power2.out",
                    },
                    0.3,
                )
                // Los nombres se escriben, con el "&" girando entre los dos
                .fromTo(
                    cierre.querySelector(".novio"),
                    { clipPath: tapado },
                    { clipPath: escrito, duration: 1, ease: "power1.inOut" },
                    0.7,
                )
                .fromTo(
                    cierre.querySelector(".amp"),
                    { opacity: 0, scale: 0.4, rotate: -25 },
                    {
                        opacity: 1,
                        scale: 1,
                        rotate: 0,
                        duration: 0.8,
                        ease: "back.out(1.8)",
                    },
                    1.4,
                )
                .fromTo(
                    cierre.querySelector(".novia"),
                    { clipPath: tapado },
                    { clipPath: escrito, duration: 1.1, ease: "power1.inOut" },
                    1.6,
                )
                .fromTo(
                    cierre.querySelector(".fecha-corta"),
                    { opacity: 0, y: 10 },
                    { opacity: 1, y: 0, duration: 0.9, ease: "power2.out" },
                    2.4,
                );
        }
    });
</script>
