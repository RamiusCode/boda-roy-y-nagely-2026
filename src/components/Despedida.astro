---
// src/components/Despedida.astro
// Cierre de la invitación: "Confirmar Asistencia" arriba, el mismo sobre
// de la portada con la tarjeta bordó por delante (el pedido, "¡Te
// esperamos!" y el botón que abre WhatsApp) y, al pie, los nombres.
//
// El sello de lacre es parte de la imagen del sobre; para que quede POR
// ENCIMA de la tarjeta se repite la misma imagen recortada al sello,
// igual que en Portada.astro.

/*
   Cuántos lugares reserva la invitación. Hoy Invitacion.astro no se lo
   pasa, así que queda en 0 y no se dibuja el renglón del pase. Para
   mostrarlo: <Despedida pases={pases} /> en Invitacion.astro.
*/
export interface Props {
    pases?: number;
}
const { pases = 0 } = Astro.props;

import { enlaceConfirmar } from "../scripts/mensajeConfirmar";
import { tamanoNombres } from "../scripts/tamanoNombres";

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Confirmar Asistencia";
const pedido = ["Por favor confirma antes del", "18 de agosto"];
const frase = "Será un honor contar con tu presencia";
const esperamos = "¡Te esperamos!";
const novios = "Roy & Nagely";
// El cierre, como la firma de una carta: la despedida y la fecha corta
const despedidaFirma = "Con amor";
const fechaCorta = "29 · 11 · 2026";
// El sobre con flores y sello (el mismo de la portada). Viene sin letras:
// el monograma se escribe encima con las iniciales de `novios`.
const sobre = "/imagenes/sobre-portada.webp";
const nombresNovios = novios.split("&").map((nombre) => nombre.trim());
// Van en un renglón: con nombres largos la letra se achica para entrar
const tamanoCierre = tamanoNombres(novios, 12.5, 166);
const iniciales = nombresNovios.map((nombre) => nombre.charAt(0));

/*
   El botón abre WhatsApp con el mensaje ya escrito, y el nombre que el
   invitado ponga en la casilla va adentro. El texto se arma en
   src/scripts/mensajeConfirmar.ts. El número va con el código de país y
   sin el + ni espacios, que es como lo pide wa.me.
*/
const noviosMensaje = "Roy y Nagely";
const fecha = "29 de noviembre de 2026";
// Un botón por número: el invitado elige a quién le confirma
const contactos = [
    { texto: "Confirmar con el novio", telefono: "59178447718" },
    { texto: "Confirmar con la novia", telefono: "59172684699" },
];
const placeholderNombre = "Escribe tu nombre";
/*
   Un enlace fijo para todos los botones. En el modelo de muestra va "#":
   los botones no llevan a ningún lado. También puede ir un link (por
   ejemplo un wa.link), pero entonces el mensaje no lleva el nombre del
   invitado. Vacío (""), cada botón vuelve a armar su mensaje con el
   nombre y su número.
*/
const enlaceFijo = "";

/*
   El pase se arma solo con el número que llega por props: 1 da "Pase para
   una persona" y 2 "Pase para dos personas". Si el número pasa la lista,
   cae al dígito ("Pase para 12 personas"). En 0 queda en null.
*/
const enLetras = [
    "", // el 0 no se usa: está para que el 1 caiga en "una"
    "una",
    "dos",
    "tres",
    "cuatro",
    "cinco",
    "seis",
    "siete",
    "ocho",
    "nueve",
    "diez",
];
const cantidad = enLetras[pases] ?? String(pases);
const pase =
    pases > 0
        ? `Pase para ${cantidad} ${pases === 1 ? "persona" : "personas"}`
        : null;
// ──────────────────────────────────────────────────────────────
---

<section id="despedida" class="seccion">
    <p class="titulo font-great-vibes">{titulo}</p>
    <p class="pedido">
        <span>{pedido[0]}</span>
        <span>{pedido[1]}</span>
    </p>

    <div id="grupo-despedida" class="grupo">
        <!-- El sobre, con sus flores, monograma y sello -->
        <img
            src={sobre}
            alt=""
            width="1400"
            height="971"
            aria-hidden="true"
            class="sobre"
        />
        <p class="monograma" aria-hidden="true">
            {iniciales[0]}<em>&</em>{iniciales[1]}
        </p>

        <!-- Tarjeta bordó por delante del sobre -->
        <div class="tarjeta">
            <p class="t-frase">{frase}</p>
            <p class="t-esperamos font-great-vibes">{esperamos}</p>
            {pase && <p class="t-pase">{pase}</p>}
            <label class="t-nombre">
                <span class="t-nombre-check" aria-hidden="true">✓</span>
                <input
                    id="confirmar-nombre"
                    type="text"
                    name="nombre"
                    autocomplete="name"
                    placeholder={placeholderNombre}
                    aria-label="Tu nombre"
                />
            </label>
            <div class="botones">
                {
                    contactos.map((c) => {
                        const datos = {
                            telefono: c.telefono,
                            novios: noviosMensaje,
                            fecha,
                        };
                        return (
                            <a
                                class="boton"
                                href={enlaceFijo || enlaceConfirmar(datos)}
                                data-confirmar={
                                    enlaceFijo ? undefined : JSON.stringify(datos)
                                }
                                target={enlaceFijo === "#" ? undefined : "_blank"}
                                rel="noopener noreferrer"
                            >
                                <span class="boton-texto">{c.texto}</span>
                                <span class="boton-brillo" aria-hidden="true" />
                            </a>
                        );
                    })
                }
            </div>

            <!-- Flor colgando en la esquina de abajo a la derecha -->
            <img
                src="/imagenes/florabajo.png"
                alt=""
                width="538"
                height="1204"
                aria-hidden="true"
                class="flor-abajo"
            />
        </div>

        <!-- El sello otra vez, recortado, para que pise la tarjeta -->
        <img
            src={sobre}
            alt=""
            width="1400"
            height="971"
            aria-hidden="true"
            class="sobre sello"
        />
    </div>

    <!-- El cierre, como la firma de una carta -->
    <div class="cierre" id="cierre-despedida">
        <div class="adorno" aria-hidden="true">
            <i class="adorno-linea adorno-izq"></i>
            <i class="adorno-rombo"></i>
            <i class="adorno-linea adorno-der"></i>
        </div>
        <p class="firma">{despedidaFirma}</p>
        <p
            class="novios font-great-vibes"
            aria-label={novios}
            style={`font-size: ${tamanoCierre}cqw;`}
        >
            <span class="novio" aria-hidden="true">{nombresNovios[0]}</span>
            <em class="amp" aria-hidden="true">&</em>
            <span class="novia" aria-hidden="true">{nombresNovios[1]}</span>
        </p>
        <p class="fecha-corta">{fechaCorta}</p>
    </div>
</section>

<style>
    .seccion {
        /* Las letras se miden contra el ancho de la sección */
        container-type: inline-size;
        position: relative;
        width: 100%;
        /* Aire abajo: es el final de la página y el botón de la música
           no tiene que tapar los nombres */
        padding: 8cqw 0 22cqw;
        text-align: center;
    }

    .titulo {
        margin: 0;
        /* Aire para los rulos: la entrada lo recorta de izquierda a derecha */
        padding: 0 4cqw;
        display: inline-block;
        color: #5b6440;
        font-size: 12cqw;
        line-height: 1.15;
    }

    .pedido {
        margin: 3cqw 0 0;
        font-family: "Cinzel", serif;
        font-size: 4.2cqw;
        line-height: 1.35;
        letter-spacing: 0.03em;
        color: #6e5a52;
    }

    .pedido span {
        display: block;
    }

    /* ── Sobre + tarjeta ────────────────────────────────────── */
    .grupo {
        position: relative;
        width: 80cqw;
        margin: 6cqw auto 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .sobre {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
        filter: drop-shadow(0 8px 14px rgba(60, 45, 25, 0.18));
    }

    /*
       El monograma, dentro del marco del sobre (41,3% a 62,7% de ancho,
       29,6% de alto). El alto se mide contra el grupo, que es más alto
       que el sobre, así que la posición va con margen: en % del ancho.
    */
    .monograma {
        position: absolute;
        top: 0;
        left: 41.3%;
        z-index: 1;
        width: 21.4%;
        aspect-ratio: 21.4 / 11.1;
        margin: 20.5% 0 0;
        display: flex;
        align-items: center;
        justify-content: center;
        /* Letra recta y en negrita: se lee mejor que la cursiva y no se
           sale del marco */
        font-family: "Cinzel", serif;
        font-weight: 700;
        font-size: 4.8cqw;
        line-height: 1;
        color: #a3303d;
        pointer-events: none;
    }

    .monograma em {
        font-style: normal;
        font-size: 0.62em;
    }

    /*
       El sello de lacre (centro en 51,2% / 64,8% de la imagen del sobre)
       recortado de una segunda copia, para que quede encima de la tarjeta.
    */
    .sello {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 3;
        pointer-events: none;
        clip-path: ellipse(10% 14.5% at 51.2% 64.8%);
        filter: drop-shadow(0 3px 4px rgba(60, 40, 10, 0.35));
    }

    /*
       La tarjeta arranca a la altura del sello: el margen negativo (en %
       del ancho del grupo) la sube sobre la parte de abajo del sobre.
       Es más ancha que la de la portada: casi todo el sobre.
    */
    .tarjeta {
        position: relative;
        z-index: 2;
        width: 98%;
        margin-top: -25%;
        padding: 14cqw 6cqw 7cqw;
        display: flex;
        flex-direction: column;
        align-items: center;
        color: #f4efe3;
        /* Como imagen y no como color: el modo oscuro forzado la respeta */
        background-image:
            radial-gradient(
                ellipse at 50% 20%,
                rgba(255, 255, 255, 0.06) 0%,
                rgba(255, 255, 255, 0) 60%
            ),
            linear-gradient(180deg, #7a2335 0%, #6f1f30 100%);
        box-shadow: 0 12px 26px rgba(70, 20, 30, 0.3);
    }

    .t-frase {
        margin: 0;
        font-family: "Cinzel", serif;
        font-size: 4.4cqw;
        line-height: 1.3;
        letter-spacing: 0.03em;
    }

    .t-esperamos {
        margin: 3cqw 0 0;
        font-size: 7.6cqw;
        line-height: 1.15;
        color: #f7f2e6;
    }

    .t-pase {
        margin: 2cqw 0 0;
        font-family: "Cinzel", serif;
        font-size: 3.8cqw;
        letter-spacing: 0.03em;
        color: #efe8d6;
    }

    /* Casilla del nombre: una línea crema sobre el bordó, con el ✓ */
    .t-nombre {
        display: flex;
        align-items: center;
        gap: 2cqw;
        width: 78%;
        margin-top: 5cqw;
        padding: 0 1cqw 1.4cqw;
        border-bottom: 1px solid rgba(239, 232, 214, 0.6);
    }

    .t-nombre-check {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 5.4cqw;
        height: 5.4cqw;
        border-radius: 50%;
        font-size: 3.4cqw;
        line-height: 1;
        color: #7a2335;
        background-image: linear-gradient(#efe8d6, #efe8d6);
    }

    .t-nombre input {
        flex: 1;
        min-width: 0;
        padding: 0;
        border: 0;
        outline: none;
        background: transparent;
        font-family: "Cormorant Garamond", serif;
        font-style: italic;
        /* 16px como mínimo: con menos, el iPhone hace zoom al escribir */
        font-size: max(16px, 4.8cqw);
        color: #f4efe3;
        text-align: center;
    }

    .t-nombre input::placeholder {
        color: rgba(244, 239, 227, 0.6);
    }

    /* Aviso suave si tocan Confirmar sin nombre */
    .t-nombre.falta {
        border-bottom-color: #f2d58a;
    }

    .botones {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3cqw;
        margin-top: 5cqw;
    }

    /* Dorado champán sobre el bordó, con un hilo claro adentro. Todos
       del mismo ancho y siempre en un solo renglón */
    .boton {
        display: block;
        width: 72cqw;
        box-sizing: border-box;
        padding: 2.4cqw 4cqw;
        border-radius: 999px;
        font-family: "Cinzel", serif;
        font-weight: 600;
        font-size: 3.8cqw;
        line-height: 1;
        letter-spacing: 0.06em;
        white-space: nowrap;
        text-align: center;
        text-decoration: none;
        color: #6f1f30;
        background-image: linear-gradient(
            180deg,
            #f3e3bd 0%,
            #e3c88c 55%,
            #d2b06a 100%
        );
        box-shadow:
            inset 0 0 0 1px rgba(255, 250, 235, 0.7),
            0 4px 12px rgba(40, 8, 15, 0.35);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    /* El brillo que cruza los botones cada tanto, recortado a su forma */
    .boton {
        position: relative;
        overflow: hidden;
    }

    .boton-texto {
        position: relative;
        z-index: 1;
    }

    .boton-brillo {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 35%;
        background-image: linear-gradient(
            105deg,
            rgba(255, 250, 235, 0) 0%,
            rgba(255, 250, 235, 0.7) 50%,
            rgba(255, 250, 235, 0) 100%
        );
        transform: translateX(-130%);
    }

    .boton:active {
        transform: scale(0.97);
        box-shadow:
            inset 0 0 0 1px rgba(255, 250, 235, 0.7),
            0 2px 6px rgba(40, 8, 15, 0.3);
    }

    /* Cuelga desde la esquina de abajo a la derecha, pisando el borde */
    .flor-abajo {
        position: absolute;
        right: -4%;
        bottom: -14%;
        width: 13%;
        height: auto;
        pointer-events: none;
        user-select: none;
        filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.2));
    }

    /* ── El cierre ─────────────────────────────────────────────── */
    .cierre {
        margin-top: 14cqw;
    }

    .adorno {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.4cqw;
    }

    .adorno-linea {
        display: block;
        width: 18cqw;
        height: 1px;
    }

    .adorno-izq {
        background-image: linear-gradient(
            90deg,
            rgba(176, 141, 87, 0) 0%,
            #b08d57 100%
        );
        transform-origin: 100% 50%;
    }

    .adorno-der {
        background-image: linear-gradient(
            90deg,
            #b08d57 0%,
            rgba(176, 141, 87, 0) 100%
        );
        transform-origin: 0% 50%;
    }

    .adorno-rombo {
        display: block;
        width: 1.9cqw;
        height: 1.9cqw;
        border: 1px solid #b08d57;
        transform: rotate(45deg);
    }

    /* "Con amor": Cinzel espaciada y dorada, como el "Nos casamos" */
    .firma {
        margin: 5cqw 0 0;
        font-family: "Cinzel", serif;
        font-size: 4.2cqw;
        line-height: 1;
        letter-spacing: 0.36em;
        /* el espaciado deja aire a la derecha: esto lo compensa */
        text-indent: 0.36em;
        text-transform: uppercase;
        color: #8a6a36;
    }

    .novios {
        margin: 2cqw 0 0;
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 2.6cqw;
        color: #7a2335;
        font-size: 12.5cqw;
        line-height: 1.15;
        white-space: nowrap;
    }

    /* Cada nombre con aire para los rulos: la entrada lo recorta */
    .novio,
    .novia {
        display: inline-block;
        padding: 0 2cqw;
    }

    /* El "&" más chico y dorado, como en NombresFlores */
    .amp {
        display: inline-block;
        font-style: normal;
        font-size: 0.62em;
        padding: 0 1cqw;
        background-image: linear-gradient(
            135deg,
            #e6cd8c 0%,
            #b8913f 45%,
            #8f6a26 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .fecha-corta {
        margin: 3cqw 0 0;
        font-family: "Cinzel", serif;
        font-size: 4cqw;
        line-height: 1;
        letter-spacing: 0.22em;
        text-indent: 0.22em;
        color: #6e5a52;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import {
        enlaceConfirmar,
        type DatosConfirmar,
    } from "../scripts/mensajeConfirmar";

    gsap.registerPlugin(ScrollTrigger);

    // Los botones con "#" (modelo de muestra) no hacen nada: sin esto, el
    // "#" sube la página hasta arriba
    document.addEventListener("DOMContentLoaded", () => {
        document
            .querySelectorAll<HTMLAnchorElement>('#despedida a[href="#"]')
            .forEach((a) => a.addEventListener("click", (e) => e.preventDefault()));
    });

    // El nombre del invitado entra en el mensaje. Va aparte de las
    // animaciones: tiene que andar aunque el visitante pida menos movimiento.
    document.addEventListener("DOMContentLoaded", () => {
        const input = document.getElementById(
            "confirmar-nombre",
        ) as HTMLInputElement | null;
        const botones = Array.from(
            document.querySelectorAll<HTMLAnchorElement>(
                "#despedida .boton[data-confirmar]",
            ),
        );
        if (!input || botones.length === 0) return;

        const casilla = input.closest(".t-nombre");

        input.addEventListener("input", () => {
            botones.forEach((boton) => {
                const datos: DatosConfirmar = JSON.parse(
                    boton.dataset.confirmar!,
                );
                boton.href = enlaceConfirmar(datos, input.value);
            });
            if (input.value.trim()) casilla?.classList.remove("falta");
        });

        // Sin nombre no sale: se marca la casilla y se lo pide
        botones.forEach((boton) => {
            boton.addEventListener("click", (e) => {
                if (input.value.trim()) return;
                e.preventDefault();
                casilla?.classList.add("falta");
                input.focus();
                gsap.fromTo(
                    casilla,
                    { x: -6 },
                    { x: 0, duration: 0.5, ease: "elastic.out(1, 0.3)" },
                );
            });
        });
    });

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("despedida");
        const grupo = document.getElementById("grupo-despedida");
        if (!seccion || !grupo) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const tarjeta = grupo.querySelector(".tarjeta");
        const flor = grupo.querySelector(".flor-abajo");
        const botones = grupo.querySelectorAll(".boton");
        const brillos = grupo.querySelectorAll(".boton-brillo");

        // Los títulos en cursiva se escriben; los márgenes negativos dejan
        // pasar los rulos
        const tapado = "inset(-40% 100% -40% 0%)";
        const escrito = "inset(-40% 0% -40% 0%)";

        let vaiven: ReturnType<typeof gsap.to> | null = null;
        let destello: ReturnType<typeof gsap.to> | null = null;

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: seccion,
                start: "top 78%",
                toggleActions: "play none none reset",
            },
            // Si la entrada se repite, lo que sigue andando espera su turno
            onStart: () => {
                vaiven?.pause();
                destello?.pause(0);
            },
        });

        tl.fromTo(
            seccion.querySelector(".titulo"),
            { clipPath: tapado },
            { clipPath: escrito, duration: 1.4, ease: "power1.inOut" },
        )
            .fromTo(
                seccion.querySelector(".pedido"),
                { opacity: 0, y: 12 },
                { opacity: 1, y: 0, duration: 0.9, ease: "power2.out" },
                0.7,
            )
            .fromTo(
                grupo,
                { opacity: 0, y: 30 },
                { opacity: 1, y: 0, duration: 1.1, ease: "power3.out" },
                0.6,
            )
            // La tarjeta sale del sobre, subiendo
            .fromTo(
                tarjeta,
                { y: 40 },
                { y: 0, duration: 1.2, ease: "power3.out" },
                0.8,
            )
            .fromTo(
                tarjeta?.querySelectorAll(".t-frase, .t-esperamos, .t-pase, .t-nombre") ??
                    [],
                { opacity: 0, y: 10 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.7,
                    stagger: 0.15,
                    ease: "power2.out",
                },
                1.2,
            )
            // Solo opacidad: los botones tienen una transición de transform
            // para el toque, y moverlos desde acá la traba
            .fromTo(
                botones,
                { opacity: 0 },
                {
                    opacity: 1,
                    duration: 0.8,
                    stagger: 0.15,
                    ease: "power2.out",
                },
                1.7,
            )
            .fromTo(
                flor,
                { opacity: 0, rotate: -8, transformOrigin: "50% 0%" },
                { opacity: 1, rotate: 0, duration: 1.1, ease: "power2.out" },
                1.1,
            )
            // Después: la flor se mece y un brillo cruza los botones cada
            // tanto. Se crean una sola vez: la entrada se repite al volver.
            .add(() => {
                if (vaiven && destello) {
                    vaiven.restart();
                    destello.restart();
                    return;
                }
                vaiven = gsap.to(flor, {
                    rotate: 3,
                    duration: 3.2,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
                destello = gsap.fromTo(
                    brillos,
                    { xPercent: -130 },
                    {
                        xPercent: 330,
                        duration: 1.2,
                        stagger: 0.25,
                        ease: "power2.inOut",
                        repeat: -1,
                        repeatDelay: 3.5,
                    },
                );
            });

        /*
           El cierre tiene su propio disparador: queda lejos. Arranca
           apenas asoma ("top bottom"): esta es la última sección y con un
           punto más exigente la página se termina antes de llegar, y los
           nombres se quedan invisibles.
        */
        const cierre = document.getElementById("cierre-despedida");
        if (cierre) {
            gsap.timeline({
                scrollTrigger: {
                    trigger: cierre,
                    start: "top bottom",
                    toggleActions: "play none none reset",
                },
            })
                // El adorno se dibuja desde el rombo
                .fromTo(
                    cierre.querySelector(".adorno-rombo"),
                    { opacity: 0, scale: 0, rotate: -45 },
                    {
                        opacity: 1,
                        scale: 1,
                        rotate: 45,
                        duration: 0.6,
                        ease: "back.out(2)",
                    },
                )
                .fromTo(
                    cierre.querySelectorAll(".adorno-linea"),
                    { scaleX: 0 },
                    { scaleX: 1, duration: 0.9, ease: "power2.out" },
                    0.15,
                )
                // "Con amor" se asienta, cerrando el espaciado
                .fromTo(
                    cierre.querySelector(".firma"),
                    { opacity: 0, letterSpacing: "0.7em" },
                    {
                        opacity: 1,
                        letterSpacing: "0.36em",
                        duration: 1.2,
                        ease: "power2.out",
                    },
                    0.3,
                )
                // Los nombres se escriben, con el "&" girando entre los dos
                .fromTo(
                    cierre.querySelector(".novio"),
                    { clipPath: tapado },
                    { clipPath: escrito, duration: 1, ease: "power1.inOut" },
                    0.7,
                )
                .fromTo(
                    cierre.querySelector(".amp"),
                    { opacity: 0, scale: 0.4, rotate: -25 },
                    {
                        opacity: 1,
                        scale: 1,
                        rotate: 0,
                        duration: 0.8,
                        ease: "back.out(1.8)",
                    },
                    1.4,
                )
                .fromTo(
                    cierre.querySelector(".novia"),
                    { clipPath: tapado },
                    { clipPath: escrito, duration: 1.1, ease: "power1.inOut" },
                    1.6,
                )
                .fromTo(
                    cierre.querySelector(".fecha-corta"),
                    { opacity: 0, y: 10 },
                    { opacity: 1, y: 0, duration: 0.9, ease: "power2.out" },
                    2.4,
                );
        }
    });
</script>
